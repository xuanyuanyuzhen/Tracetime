<Window x:Class="TraceTime.App.AiConfigWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AI 服务配置 · TraceTime" Width="680" Height="760" MinWidth="540" MinHeight="520" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}">
 <Border Background="{DynamicResource Canvas}" Padding="26"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="配置 AI 服务" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="先选择服务类型，再填写连接信息。保存配置不会发送使用记录。" Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel>
  <ScrollViewer x:Name="ConfigScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><StackPanel>
   <TextBlock Text="服务类型" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <UniformGrid Columns="3"><RadioButton x:Name="OpenAiPreset" Content="OpenAI 官方" GroupName="Provider" Tag="openai" Checked="ProviderChanged" Style="{StaticResource Choice}" Padding="8"/><RadioButton x:Name="LocalPreset" Content="本机服务" GroupName="Provider" Tag="local" Checked="ProviderChanged" Style="{StaticResource Choice}" Padding="8"/><RadioButton x:Name="CustomPreset" Content="兼容 / 自定义" GroupName="Provider" Tag="compatible" Checked="ProviderChanged" Style="{StaticResource Choice}" Padding="8"/></UniformGrid>
   <TextBlock x:Name="ProviderHint" Style="{StaticResource Hint}" Margin="0,8,0,18"/>
   <TextBlock Text="配置名称（可选）"/><TextBox x:Name="ConfigName" MaxLength="60" Margin="0,7,0,16" AutomationProperties.Name="AI配置名称"/>
   <DockPanel Margin="0,0,0,7"><TextBlock Text="请求地址" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><RadioButton x:Name="BaseAddress" Content="基础地址" GroupName="AddressMode" Style="{StaticResource Choice}" IsChecked="True" Checked="AddressModeChanged" Padding="8,5" MinHeight="30"/><RadioButton x:Name="FullAddress" Content="完整接口" GroupName="AddressMode" Style="{StaticResource Choice}" Checked="AddressModeChanged" Padding="8,5" MinHeight="30"/></StackPanel></DockPanel>
   <TextBox x:Name="AddressInput" MaxLength="2048" TextChanged="ConnectionChanged" AutomationProperties.Name="AI服务请求地址"/>
   <TextBlock x:Name="EndpointHint" Style="{StaticResource Hint}" Margin="0,7,0,16"/>
   <TextBlock Text="API Key" FontWeight="SemiBold"/><PasswordBox x:Name="KeyInput" MinHeight="38" Padding="10,8" Margin="0,7,0,6" MaxLength="16384" PasswordChanged="KeyChanged" AutomationProperties.Name="API密钥"/>
   <DockPanel Margin="0,0,0,18"><Button x:Name="ClearKeyButton" Content="清除已存密钥" DockPanel.Dock="Right" Click="ClearStoredKey" Padding="8,5" MinHeight="30"/><TextBlock x:Name="KeyHint" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0"/></DockPanel>
   <DockPanel Margin="0,0,0,8"><TextBlock Text="分析模型" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="FetchModelsButton" Content="获取模型列表" Click="FetchModels" HorizontalAlignment="Right" Padding="10,6" MinHeight="34"/></DockPanel>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><RadioButton x:Name="SelectModelMode" Content="从列表选择" GroupName="ModelMode" Checked="ModelModeChanged" Style="{StaticResource Choice}" Padding="10,5" MinHeight="32"/><RadioButton x:Name="ManualModelMode" Content="手动填写" IsChecked="True" GroupName="ModelMode" Checked="ModelModeChanged" Style="{StaticResource Choice}" Padding="10,5" MinHeight="32"/></StackPanel>
   <ComboBox x:Name="ModelList" MinHeight="38" MaxDropDownHeight="180" Visibility="Collapsed" AutomationProperties.Name="可用分析模型"/>
   <TextBox x:Name="ManualModel" MaxLength="200" AutomationProperties.Name="手动填写模型ID"/>
   <TextBlock Text="模型列表由你的服务返回，不代表所有模型都支持文字分析。也可填写服务商提供的 ID。获取列表只发送鉴权信息，不发送使用记录。" Style="{StaticResource Hint}" Margin="0,8,0,16"/>
   <TextBlock Text="连接采用 Chat Completions 兼容格式。密钥仅在本机以当前 Windows 用户身份加密保存。" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="{DynamicResource Warning}" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Click="CancelConfig"/><Button x:Name="SaveButton" Content="保存配置" Style="{StaticResource PrimaryButton}" Click="SaveConfig" Margin="10,0,0,0" IsDefault="True"/></StackPanel></StackPanel>
 </Grid></Border>
</Window>
