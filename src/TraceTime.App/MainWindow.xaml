<Window x:Class="TraceTime.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TraceTime.App" Title="TraceTime · 每日应用时长" Width="1160" Height="860" MinWidth="900" MinHeight="620" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen" Closing="WindowClosing">
 <Grid Background="{DynamicResource Canvas}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
   <Grid Margin="16,28,16,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <StackPanel Orientation="Horizontal" Margin="8,0,0,34">
      <Grid Width="27" Height="27" Margin="0,0,10,0"><Ellipse Stroke="{DynamicResource Accent}" StrokeThickness="2.3"/><Path Data="M13.5,6 L13.5,14 L19,17" Stroke="{DynamicResource Accent}" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid>
      <TextBlock Text="TraceTime" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </StackPanel>
     <Button x:Name="OverviewNav" Style="{StaticResource NavButton}" Click="ShowOverview"><StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Stretch="Uniform" Data="M1,1 L7,1 L7,7 L1,7 Z M11,1 L17,1 L17,7 L11,7 Z M1,11 L7,11 L7,17 L1,17 Z M11,11 L17,11 L17,17 L11,17 Z" Stroke="{DynamicResource Accent}" StrokeThickness="1.6" Margin="0,0,12,0"/><TextBlock Text="每日概览"/></StackPanel></Button>
     <Button x:Name="AppearanceNav" Style="{StaticResource NavButton}" Click="ShowAppearance"><StackPanel Orientation="Horizontal"><Path Width="17" Height="17" Stretch="Uniform" Data="M9,1 C-2,1 -2,17 8,17 C12,17 8,12 12,12 C22,13 19,1 9,1 Z M5,6 L5,7 M9,4 L9,5 M13,6 L13,7" Stroke="{DynamicResource Muted}" StrokeThickness="1.6" Margin="0,0,11,0"/><TextBlock Text="外观与主题"/></StackPanel></Button>
     <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="ShowSettings"><StackPanel Orientation="Horizontal"><Path Width="17" Height="17" Stretch="Uniform" Data="M1,4 L17,4 M1,9 L17,9 M1,14 L17,14 M5,1 L5,7 M12,6 L12,12 M7,11 L7,17" Stroke="{DynamicResource Muted}" StrokeThickness="1.6" Margin="0,0,11,0"/><TextBlock Text="设置与数据"/></StackPanel></Button>
    </StackPanel>
    <StackPanel Grid.Row="2">
     <Button Click="ToggleTheme" ToolTip="快速切换浅色或深色，选择会自动保存" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="{DynamicResource Divider}"><StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Stretch="Uniform" Data="M12,1 C4,5 7,14 15,13 C10,20 -1,15 1,8 C2,3 6,0 12,1 Z" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" Margin="0,0,10,0"/><TextBlock x:Name="QuickThemeLabel" Text="切换深色"/></StackPanel></Button>
     <TextBlock Text="你的时间，只留在本机。" Style="{StaticResource Hint}" Margin="8,22,0,0"/>
     <TextBlock Text="TraceTime  0.2" Style="{StaticResource Hint}" Margin="8,8,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="30,26,22,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,8,22">
    <Button x:Name="PauseButton" DockPanel.Dock="Right" Content="暂停记录" Click="TogglePause" Margin="14,0,0,0" VerticalAlignment="Top"/>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,13,0,0"><Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource Accent}" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="正在记录" Foreground="{DynamicResource Muted}" FontSize="12"/></StackPanel>
    <StackPanel><TextBlock x:Name="PageTitle" Text="每日概览" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="看见时间的去向。" Style="{StaticResource Hint}" Margin="0,7,0,0"/></StackPanel>
   </DockPanel>
   <Border x:Name="ErrorBanner" Grid.Row="1" Background="{DynamicResource WarningSurface}" CornerRadius="8" Padding="12,9" Visibility="Collapsed" Margin="0,0,8,12"><TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource Warning}"/></Border>
   <ScrollViewer x:Name="OverviewPanel" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
    <StackPanel>
     <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="DayLabel" Text="今天" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
       <Button Width="34" Padding="10" Click="PreviousDay" ToolTip="前一天" AutomationProperties.Name="前一天"><Path Data="M6,0 L0,5 L6,10" Stroke="{DynamicResource Muted}" StrokeThickness="1.5"/></Button>
       <DatePicker x:Name="DayPicker" Width="156" Margin="6,0" SelectedDateChanged="DateChanged" AutomationProperties.Name="查看日期"/>
       <Button x:Name="NextDayButton" Width="34" Padding="10" Click="NextDay" ToolTip="后一天" AutomationProperties.Name="后一天"><Path Data="M0,0 L6,5 L0,10" Stroke="{DynamicResource Muted}" StrokeThickness="1.5"/></Button>
       <Button Content="今天" Click="Today" Margin="8,0,0,0"/>
      </StackPanel>
     </Grid>
     <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource SurfacePanel}"><StackPanel><DockPanel><Path DockPanel.Dock="Right" Data="M9,1 A8,8 0 1 1 8.99,1 M9,4 L9,9 L13,11" Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.4"/><TextBlock Text="前台停留" Foreground="{DynamicResource Muted}"/></DockPanel><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="43" Margin="0,6,0,5"><TextBlock x:Name="ForegroundTotal" Text="0 秒" FontSize="35" FontWeight="SemiBold"/></Viewbox><TextBlock Text="包含没有键鼠操作的时间" Style="{StaticResource Hint}"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource SurfacePanel}"><StackPanel><DockPanel><Path DockPanel.Dock="Right" Data="M1,10 L5,10 L8,3 L12,17 L15,10 L19,10" Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource Accent}" StrokeThickness="1.4"/><TextBlock Text="扣除空闲后" Foreground="{DynamicResource Muted}"/></DockPanel><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="43" Margin="0,6,0,5"><TextBlock x:Name="WithoutIdleTotal" Text="0 秒" Foreground="{DynamicResource Accent}" FontSize="35" FontWeight="SemiBold"/></Viewbox><TextBlock x:Name="IdleHint" Text="近期时长可能随空闲判定调整" Style="{StaticResource Hint}"/></StackPanel></Border>
     </Grid>
     <Border Style="{StaticResource SurfacePanel}">
      <StackPanel>
       <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="应用排行" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="AppCountLabel" Text="0 个应用" Style="{StaticResource Hint}" Margin="12,4,0,0"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource Track}" CornerRadius="10" Padding="3"><StackPanel Orientation="Horizontal"><RadioButton x:Name="ForegroundMetric" Content="前台停留" GroupName="Metric" IsChecked="True" Checked="MetricChanged" Style="{StaticResource Choice}" Padding="11,7" MinHeight="32" FontSize="12"/><RadioButton x:Name="ActiveMetric" Content="扣除空闲后" GroupName="Metric" Checked="MetricChanged" Style="{StaticResource Choice}" Padding="11,7" MinHeight="32" FontSize="12"/></StackPanel></Border></Grid>
       <Grid x:Name="RankingHeader" Margin="12,0,12,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="118"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="应用" Style="{StaticResource Hint}"/><TextBlock Grid.Column="1" Text="时长" HorizontalAlignment="Right" Style="{StaticResource Hint}"/><TextBlock Grid.Column="2" Text="占比" HorizontalAlignment="Right" Style="{StaticResource Hint}"/></Grid>
       <ListBox x:Name="AppList" MaxHeight="310" SelectionChanged="AppSelected" ItemContainerStyle="{StaticResource DataRow}" AutomationProperties.Name="应用使用排行">
        <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="118"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Rank}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
         <Grid Grid.Column="1" Width="30" Height="30" HorizontalAlignment="Left"><Border CornerRadius="8" Background="{DynamicResource AccentSoft}"/><TextBlock Text="{Binding Initial}" Foreground="{Binding Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Visibility="{Binding LetterVisibility}"/><Image Source="{Binding Icon}" Width="24" Height="24"/></Grid>
         <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><Grid Height="4" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding BarFraction}"/><ColumnDefinition Width="{Binding RemainingFraction}"/></Grid.ColumnDefinitions><Border Grid.ColumnSpan="2" Background="{DynamicResource Track}" CornerRadius="2"/><Border Background="{Binding Brush}" CornerRadius="2"/></Grid></StackPanel>
         <TextBlock Grid.Column="3" Text="{Binding Duration}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock Grid.Column="4" Text="{Binding Percent}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
        </Grid></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <StackPanel x:Name="EmptyPanel" Margin="10,30,10,34" Visibility="Collapsed"><TextBlock x:Name="EmptyTitle" Text="今天的记录，从现在开始" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyDescription" Text="记录会自动累积，切换应用后再来看看。" Foreground="{DynamicResource Muted}" TextAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource SurfacePanel}" Margin="0,18,0,0" Padding="22,12">
           <Expander x:Name="TimelineExpander" Header="展开每日时间线" Margin="0" Expanded="TimelineExpanded" Collapsed="TimelineCollapsed" FontSize="14">
      <StackPanel Margin="0,12,0,0">
       <DockPanel><TextBlock x:Name="SelectionLabel" Text="全部应用" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><Button Content="清除选择" Click="ClearSelection" HorizontalAlignment="Right" MinHeight="26" Padding="8,3" FontSize="12"/></DockPanel>
       <local:TimelineView x:Name="Timeline" Height="112" Margin="0,8,0,0"/>
       <TextBlock Text="彩色：前台使用    淡色：空闲    灰块：暂停或中断    留白：未记录" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
       <ListBox x:Name="DetailsList" MaxHeight="320" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="完整时间片列表，可用方向键浏览">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource DataRow}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="4,6"/><Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Range}" FontSize="12" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/><TextBlock Grid.Column="2" Text="{Binding Duration}" FontSize="12" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}"/></Grid></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock x:Name="DetailHint" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
      </StackPanel>
     </Expander>

     </Border>
    </StackPanel>
   </ScrollViewer>
   <ScrollViewer x:Name="AppearancePanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
    <StackPanel>
     <Border Style="{StaticResource SurfacePanel}" Margin="0,0,0,16"><StackPanel>
      <TextBlock Text="明暗模式" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="跟随系统，或为 TraceTime 单独选择外观。" Style="{StaticResource Hint}" Margin="0,7,0,16"/>
      <UniformGrid Columns="3"><RadioButton x:Name="SystemMode" GroupName="ThemeMode" Tag="system" Content="跟随系统" Style="{StaticResource Choice}" Checked="ModeChanged" Margin="0,0,8,0"/><RadioButton x:Name="LightMode" GroupName="ThemeMode" Tag="light" Content="浅色" Style="{StaticResource Choice}" Checked="ModeChanged" Margin="0,0,8,0"/><RadioButton x:Name="DarkMode" GroupName="ThemeMode" Tag="dark" Content="深色 · 夜间模式" Style="{StaticResource Choice}" Checked="ModeChanged"/></UniformGrid>
     </StackPanel></Border>
     <Border Style="{StaticResource SurfacePanel}" Margin="0,0,0,16"><StackPanel>
      <TextBlock Text="界面风格" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="同一份时间记录，不同的视觉感受。" Style="{StaticResource Hint}" Margin="0,7,0,14"/>
      <UniformGrid Columns="3">
       <RadioButton x:Name="GlassStyle" GroupName="Material" Tag="glass" Style="{StaticResource Choice}" Checked="MaterialChanged" HorizontalContentAlignment="Stretch" Padding="10" Margin="0,0,8,0" AutomationProperties.Name="液态玻璃风格"><StackPanel><Border Height="78" CornerRadius="9" Padding="12"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#A0C8CC"/><GradientStop Color="#DFEAF0" Offset="0.55"/><GradientStop Color="#B0BFD2" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Border Width="52" Height="36" CornerRadius="7" Background="#AFFFFFFF" BorderBrush="#EEFFFFFF" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"/><Border Width="60" Height="34" CornerRadius="7" Background="#BFFFFFFF" BorderBrush="White" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid></Border><TextBlock Text="液态玻璃" FontWeight="SemiBold" Margin="0,11,0,5"/><TextBlock Text="通透层次 · 细腻高光" Style="{StaticResource Hint}"/></StackPanel></RadioButton>
       <RadioButton x:Name="SoftStyle" GroupName="Material" Tag="soft" Style="{StaticResource Choice}" Checked="MaterialChanged" HorizontalContentAlignment="Stretch" Padding="10" Margin="0,0,8,0" AutomationProperties.Name="柔和风格"><StackPanel><Border Height="78" CornerRadius="9" Background="#E4E9ED" Padding="13"><Border CornerRadius="9" Background="#F9FAFB" Padding="12"><StackPanel><Border Background="#B2C3CB" Width="42" Height="5" CornerRadius="2" HorizontalAlignment="Left"/><Border Background="#D6DFE4" Height="5" CornerRadius="2" Margin="0,8,0,0"/></StackPanel></Border></Border><TextBlock Text="柔和" FontWeight="SemiBold" Margin="0,11,0,5"/><TextBlock Text="柔润圆角 · 安静留白" Style="{StaticResource Hint}"/></StackPanel></RadioButton>
       <RadioButton x:Name="MinimalStyle" GroupName="Material" Tag="minimal" Style="{StaticResource Choice}" Checked="MaterialChanged" HorizontalContentAlignment="Stretch" Padding="10" AutomationProperties.Name="极简风格"><StackPanel><Border Height="78" CornerRadius="6" Background="#F7F8FA" BorderBrush="#CFD8DF" BorderThickness="1" Padding="14"><StackPanel><Border Background="#697B89" Width="38" Height="5" HorizontalAlignment="Left"/><Border Background="#D3DCE2" Height="1" Margin="0,11,0,0"/><Border Background="#D3DCE2" Height="1" Margin="0,10,0,0"/></StackPanel></Border><TextBlock Text="极简" FontWeight="SemiBold" Margin="0,11,0,5"/><TextBlock Text="清晰线条 · 轻量平面" Style="{StaticResource Hint}"/></StackPanel></RadioButton>
      </UniformGrid>
     </StackPanel></Border>
     <Border Style="{StaticResource SurfacePanel}"><StackPanel>
      <DockPanel><TextBlock x:Name="AccentName" DockPanel.Dock="Right" Text="湖泊青" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/><TextBlock Text="调色盘" Style="{StaticResource SectionTitle}"/></DockPanel>
      <TextBlock Text="用于按钮、选中状态和时长。应用图表保留各自的颜色。" Style="{StaticResource Hint}" Margin="0,7,0,16"/>
      <WrapPanel x:Name="Swatches">
       <RadioButton Style="{StaticResource Swatch}" GroupName="Accent" Tag="#24777B" ToolTip="湖泊青" AutomationProperties.Name="湖泊青" Checked="AccentChanged"><Ellipse Width="28" Height="28" Fill="#24777B"/></RadioButton>
       <RadioButton Style="{StaticResource Swatch}" GroupName="Accent" Tag="#3564C0" ToolTip="远山蓝" AutomationProperties.Name="远山蓝" Checked="AccentChanged"><Ellipse Width="28" Height="28" Fill="#3564C0"/></RadioButton>
       <RadioButton Style="{StaticResource Swatch}" GroupName="Accent" Tag="#7956B3" ToolTip="鸢尾紫" AutomationProperties.Name="鸢尾紫" Checked="AccentChanged"><Ellipse Width="28" Height="28" Fill="#7956B3"/></RadioButton>
       <RadioButton Style="{StaticResource Swatch}" GroupName="Accent" Tag="#A64E6E" ToolTip="玫瑰粉" AutomationProperties.Name="玫瑰粉" Checked="AccentChanged"><Ellipse Width="28" Height="28" Fill="#A64E6E"/></RadioButton>
       <RadioButton Style="{StaticResource Swatch}" GroupName="Accent" Tag="#A56820" ToolTip="琥珀金" AutomationProperties.Name="琥珀金" Checked="AccentChanged"><Ellipse Width="28" Height="28" Fill="#A56820"/></RadioButton>
       <RadioButton Style="{StaticResource Swatch}" GroupName="Accent" Tag="#3F805C" ToolTip="森林绿" AutomationProperties.Name="森林绿" Checked="AccentChanged"><Ellipse Width="28" Height="28" Fill="#3F805C"/></RadioButton>
      </WrapPanel>
      <WrapPanel Margin="0,16,0,0"><TextBlock Text="自定义色值" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox x:Name="HexInput" Width="106" MaxLength="7" AutomationProperties.Name="自定义颜色，格式为井号加六位十六进制" KeyDown="HexKeyDown"/><Button Content="应用" Click="ApplyHex" Margin="8,0,0,0"/><Button Content="更多颜色…" Click="ChooseColor" Margin="8,0,0,0"/></WrapPanel>
      <TextBlock Text="输入 #RRGGBB；强调色会随明暗模式调整以保持清晰。" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
     </StackPanel></Border>
     <DockPanel Margin="0,16,0,8"><Button Content="恢复默认外观" DockPanel.Dock="Right" Click="ResetAppearance"/><TextBlock x:Name="AppearanceFeedback" Text="选择后立即生效，自动保存。" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0"/></DockPanel>
    </StackPanel>
   </ScrollViewer>
      <ScrollViewer x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
    <StackPanel><Border Style="{StaticResource SurfacePanel}"><StackPanel>
     <TextBlock Text="记录偏好" Style="{StaticResource SectionTitle}" Margin="0,12,0,18"/>
     <TextBlock Text="空闲判定阈值" FontWeight="SemiBold"/>
     <StackPanel Orientation="Horizontal" Margin="0,10,0,8"><TextBox x:Name="IdleInput" Text="5" Width="80" MaxLength="2" AutomationProperties.Name="空闲分钟数"/><TextBlock Text="分钟没有键鼠操作" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
     <TextBlock Text="可设置 1–60 分钟。修改只影响之后的记录，历史数据保持原判定。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/>
     <TextBlock Text="达到阈值后，从最后一次操作开始扣除；阅读和看视频也可能被判断为空闲。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,16"/>
     <CheckBox x:Name="StartupCheck" Content="登录 Windows 后自动启动，收起到托盘" Margin="0,0,0,18"/>
     <Button Content="保存偏好" Click="SavePreferences" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
     <TextBlock x:Name="SettingsFeedback" Foreground="{DynamicResource Accent}" Margin="0,10,0,0" TextWrapping="Wrap"/>
     <Border Height="1" Background="{DynamicResource Divider}" Margin="0,28"/>
     <TextBlock Text="数据管理" Style="{StaticResource SectionTitle}"/>
     <TextBlock Text="选择日期范围，导出每日应用汇总或删除该范围内的记录。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,12,0,14" TextWrapping="Wrap"/>
     <StackPanel Orientation="Horizontal"><DatePicker x:Name="RangeStart" Width="150" AutomationProperties.Name="开始日期"/><TextBlock Text="至" Margin="14,0" VerticalAlignment="Center"/><DatePicker x:Name="RangeEnd" Width="150" AutomationProperties.Name="结束日期"/></StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,16,0,16"><Button Content="导出 CSV" Click="Export"/><Button Content="删除所选记录" Foreground="{DynamicResource Danger}" Margin="12,0,0,0" Click="DeleteRecords"/></StackPanel>
     <TextBlock Text="存储位置" FontSize="12" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="StoragePath" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,8"/><Button Content="打开数据文件夹" HorizontalAlignment="Left" Click="OpenDataFolder"/>
     <Border Height="1" Background="{DynamicResource Divider}" Margin="0,28"/>
     <TextBlock Text="关闭窗口后会继续在托盘记录。需要停止时，可以暂停或退出。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/>
     <Button Content="退出 TraceTime" Click="ExitApp" HorizontalAlignment="Left" Margin="0,14,0,12"/>
    </StackPanel></Border></StackPanel>
   </ScrollViewer>

   <DockPanel Grid.Row="3" Margin="0,16,8,0"><TextBlock x:Name="ThemeSummary" DockPanel.Dock="Right" Style="{StaticResource Hint}"/><TextBlock Text="关闭窗口后继续在托盘记录" Style="{StaticResource Hint}"/></DockPanel>
  </Grid>
 </Grid>
</Window>
